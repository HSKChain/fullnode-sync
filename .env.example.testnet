# op-reth image
RETH_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-reth:v2.8.1
# comma-separated enode URLs for op-reth trusted peers
RETH_TRUSTED_PEERS="enode://0492e74fb10579a3c53a327ee42dc70db35e7e0aebd73793a806afccb86b30acecb8fe9d024e06bb3fd154c678926d884df3ae696c71adcbf1339a5762e19c4d@testnet-bootnodes.hsk.xyz:30303,enode://dba82c6b384844a00a54ecdfcb34c209ea714072558db80512d4c65e760846d054cf3f58a826cba33b6b410498559b7e41b147dfa487f8cba3d25d2b5bb9e7bc@testnet-bootnodes.hsk.xyz:30304"
# genesis file url link
GENESIS_URL="https://hashkeychain.s3.ap-southeast-1.amazonaws.com/testnet/genesis.json"
# reth mode: full (pruned) or archive
RETH_MODE=full
# reth http/ws api (engine is only on authrpc:8551)
HTTP_API="web3,eth,net"
WS_API="web3,eth,net"
# tx forward endpoint
SEQUENCER_HTTP=https://testnet.hsk.xyz

# OP_NODE_LOG_LEVEL=Debug
# node image
NODE_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-node:v1.19.11

# l1 rpc url
L1_RPC=
# l1 rpc kind(standard/basic/quicknode/alchemy/erigon)
# https://docs.optimism.io/operators/node-operators/tutorials/node-from-docker
L1_RPC_KIND=standard

# l1 beacon url
L1_BEACON=
# node libp2p bootnodes dns/ip4
P2P_STATIC='/dns/testnet-bootnodes.hsk.xyz/tcp/9003/p2p/16Uiu2HAmK91SZeGrr7Tv7hKBJsNcbVjzNtZBKmGzq5hLo5AtSoHa,/dns/testnet-bootnodes.hsk.xyz/tcp/9004/p2p/16Uiu2HAmTJHvcpkC8miMRhHr9ionQtEVMbCGshmU2nv4ir5ZA68j'
# rollup config file url link
ROLLUP_CONFIG_URL="https://hashkeychain.s3.ap-southeast-1.amazonaws.com/testnet/rollup.json"
