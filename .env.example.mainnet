# op-reth image
RETH_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-reth:v2.8.1
# comma-separated enode URLs for op-reth trusted peers
RETH_TRUSTED_PEERS="enode://5ecd6d2054a58fa00729b73396044a35e6aceeafe58373d2f26b3f50a3934175fb56f8efa538381430889771613beaabf1177805910bbd34e4b4840320914690@mainnet-bootnodes.hsk.xyz:30615,enode://bd244da2a066e15f82d4bfb7f2732c5b5bac44cefb36cefef01a4c0e87e72b42004d012c9a294b8402ebf67491777f280ffbcc93a71157921d6d358b19ddac67@mainnet-bootnodes.hsk.xyz:30616,enode://a5bba6459ac3a075a4a8941478a4ef8d167460191c89632004b17e4b2d7beea52cdc1a2d376f35e996ad44ccac8db25f900700aad6991d015bdc4db072832063@mainnet-bootnodes.hsk.xyz:30617"
# genesis file url link
GENESIS_URL="https://hashkeychain.s3.ap-southeast-1.amazonaws.com/mainnet/genesis.json"
# reth mode: full (pruned) or archive
RETH_MODE=full
# reth http/ws api (engine is only on authrpc:8551)
HTTP_API="web3,eth,net"
WS_API="web3,eth,net"
# tx forward endpoint
SEQUENCER_HTTP=https://mainnet.hsk.xyz

# OP_NODE_LOG_LEVEL=Debug
# node image
NODE_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-node:v1.19.11

# l1 rpc url
L1_RPC=
# l1 rpc kind(standard/basic/quicknode/alchemy/erigon)
# https://docs.optimism.io/operators/node-operators/tutorials/node-from-docker
L1_RPC_KIND=standard

# l1 beacon url
L1_BEACON=
# node libp2p bootnodes dns/ip4
P2P_STATIC="/dns/mainnet-bootnodes.hsk.xyz/tcp/31329/p2p/16Uiu2HAm8itEpr6DRkQhezSWS8WsAGfiLhzv2Y6KK1k2KVGv5PJQ,/dns/mainnet-bootnodes.hsk.xyz/tcp/31330/p2p/16Uiu2HAm79eNjZYakcTmsyifeMQykwArEd6bUU6EQgf3XvCmCKSY,/dns/mainnet-bootnodes.hsk.xyz/tcp/31331/p2p/16Uiu2HAm9WzPWe3szua51vyrj3dZsez89R3fGwAfMexE5568mEyP"
# rollup config file url link
ROLLUP_CONFIG_URL="https://hashkeychain.s3.ap-southeast-1.amazonaws.com/mainnet/rollup.json"
